<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>UNIT_TEST</DefineConstants>
    <DefaultItemExcludes>$(DefaultItemExcludes);chart/**;native/**</DefaultItemExcludes>
    <NoWarn>CS8618;CS0067;CS0169;CS0414;CS8602;CS8625;CS8604</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Screeny)/Services/DatabaseService.cs;$(Screeny)/Services/UsageSliceWriter.cs;$(Screeny)/Services/PersistenceResult.cs;$(Screeny)/Services/WindowTrackingService.cs;$(Screeny)/MainViewModel.cs;$(Screeny)/Models/*.cs;$(Screeny)/Helpers/ApplicationProcessingHelper.cs;$(Screeny)/Helpers/ApplicationNameNormalizer.cs;$(Screeny)/Helpers/TimeFormatter.cs" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.4" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="SQLite" Version="3.54.1" />
  </ItemGroup>
</Project>
